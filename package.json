{
  "name": "times-inc",
  "private": true,
  "version": "4.1.9",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:security-boundaries": "node scripts/check-security-boundaries.mjs",
    "audit:launch": "node scripts/audit-launch-readiness.mjs",
    "repair:launch-data": "node scripts/repair-launch-data.mjs",
    "repair:push-subscriptions": "node scripts/repair-push-subscriptions.mjs",
    "audit:notifications": "node scripts/audit-notifications.mjs",
    "repair:notifications": "node scripts/repair-notifications.mjs --apply",
    "repair:record-tombstones": "node scripts/repair-record-tombstones.mjs",
    "audit:record-drift": "node scripts/repair-record-table-drift.mjs",
    "repair:record-table-drift": "node scripts/repair-record-table-drift.mjs --apply",
    "audit:plaintext-pins": "node scripts/repair-plaintext-pins.mjs",
    "repair:plaintext-pins": "node scripts/repair-plaintext-pins.mjs --apply",
    "audit:auth-identities": "node scripts/reconcile-auth-identities.mjs",
    "repair:auth-identities": "node scripts/reconcile-auth-identities.mjs --apply",
    "audit:blob-health": "node scripts/repair-blob-table-drift.mjs",
    "repair:blob-table-drift": "node scripts/repair-blob-table-drift.mjs --apply",
    "backup:production": "node scripts/backup-production-data.mjs",
    "verify:rls-readiness": "node scripts/audit-launch-readiness.mjs --strict",
    "verify:release": "npm run typecheck && npm run test && npm run test:security-boundaries && npm run build && npm run test:e2e && npm run test:bundle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.111.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7",
    "write-excel-file": "^4.1.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "overrides": {
    "@vite-pwa/assets-generator": {
      "sharp": "0.35.3"
    },
    "filelist": {
      "brace-expansion": "2.1.3"
